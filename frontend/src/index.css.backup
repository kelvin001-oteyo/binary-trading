







/* ============================================================
   GLOBAL THEME — Dark Mode
   ============================================================ */

:root {
  --brand: #2563eb;
  --brand-light: #3b82f6;
  --bg-dark: #0f172a;
  --bg-darker: #0b1220;
  --bg-card: #ffffff;
  --bg-hover: #f8fafc;
  --text-dark: #0f172a;
  --text-light: #64748b;
  --text-muted: #94a3b8;
  --border: #e5e7eb;
  --border-dark: #1f2937;
  --success: #22c55e;
  --danger: #ef4444;
  --warning: #f59e0b;
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html, body {
  height: 100%;
  font-family: 'Inter', system-ui, -apple-system, sans-serif;
  background-color: #f1f5f9;
  color: var(--text-dark);
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

#root {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

a {
  color: inherit;
  text-decoration: none;
}

img, svg {
  display: block;
  max-width: 100%;
}

input, select, textarea, button {
  font-family: inherit;
  font-size: inherit;
}

/* ============================================================
   APP SHELL — Sidebar + Main Content
   ============================================================ */

.app-shell {
  display: grid;
  grid-template-columns: 260px 1fr;
  min-height: 100vh;
  background: #f1f5f9;
}

/* ---------- Sidebar ---------- */

.sidebar {
  background: #0f172a;
  color: #cbd5e1;
  display: flex;
  flex-direction: column;
  padding: 20px 0;
  position: sticky;
  top: 0;
  height: 100vh;
  overflow-y: auto;
  border-right: 1px solid #1f2937;
}

.sidebar-brand {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 0 22px 22px 22px;
  border-bottom: 1px solid #1f2937;
  margin-bottom: 16px;
}

.brand-mark {
  width: 40px;
  height: 40px;
  border-radius: 10px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #2563eb, #7c3aed);
  color: #ffffff;
  font-weight: 800;
  font-size: 14px;
  flex-shrink: 0;
}

.sidebar-brand strong {
  display: block;
  color: #ffffff;
  font-size: 15px;
  font-weight: 800;
  letter-spacing: -0.01em;
}

.sidebar-brand span {
  display: block;
  color: #64748b;
  font-size: 11.5px;
  font-weight: 600;
  margin-top: 2px;
}

.sidebar-demo {
  margin: 0 22px 18px 22px;
  padding: 6px 10px;
  background: rgba(34, 197, 94, 0.12);
  color: #4ade80;
  font-size: 10.5px;
  font-weight: 800;
  letter-spacing: 0.08em;
  border-radius: 6px;
  text-align: center;
}

.sidebar-nav {
  flex: 1;
  padding: 0 12px;
  overflow-y: auto;
}

.nav-section-title {
  padding: 16px 12px 8px 12px;
  font-size: 10.5px;
  font-weight: 800;
  letter-spacing: 0.1em;
  color: #475569;
  text-transform: uppercase;
}

.nav-link {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 10px 12px;
  margin-bottom: 2px;
  border-radius: 8px;
  color: #cbd5e1;
  font-size: 13.5px;
  font-weight: 600;
  text-decoration: none;
  transition: background 0.15s ease, color 0.15s ease;
  position: relative;
}

.nav-link:hover {
  background: rgba(255, 255, 255, 0.06);
  color: #ffffff;
}

.nav-link.active {
  background: linear-gradient(90deg, rgba(37, 99, 235, 0.2), rgba(37, 99, 235, 0.05));
  color: #ffffff;
  border-left: 3px solid #3b82f6;
  padding-left: 9px;
}

.nav-icon {
  width: 20px;
  text-align: center;
  font-size: 14px;
  color: #64748b;
  flex-shrink: 0;
}

.nav-link.active .nav-icon,
.nav-link:hover .nav-icon {
  color: #60a5fa;
}

.sidebar-bottom {
  padding: 16px 12px 0 12px;
  border-top: 1px solid #1f2937;
  margin-top: 12px;
}

.sidebar-user {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 8px 10px;
  margin-bottom: 8px;
}

.user-avatar {
  width: 34px;
  height: 34px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #2563eb, #7c3aed);
  color: #ffffff;
  font-weight: 800;
  font-size: 13px;
  flex-shrink: 0;
}

.sidebar-user strong {
  display: block;
  color: #ffffff;
  font-size: 13px;
  font-weight: 700;
}

.sidebar-user span {
  display: block;
  color: #64748b;
  font-size: 11px;
}

.sidebar-logout {
  display: flex;
  align-items: center;
  gap: 8px;
  width: 100%;
  padding: 10px 12px;
  background: transparent;
  border: 1px solid #1f2937;
  border-radius: 8px;
  color: #cbd5e1;
  font-size: 13px;
  font-weight: 700;
  cursor: pointer;
  transition: all 0.15s ease;
}

.sidebar-logout:hover {
  background: rgba(239, 68, 68, 0.1);
  border-color: rgba(239, 68, 68, 0.3);
  color: #fca5a5;
}

/* ---------- Main Content Area ---------- */

.app-content {
  padding: 28px 32px 80px 32px;
  min-width: 0;
}

.app-content > * {
  max-width: 1280px;
  margin: 0 auto;
}

/* ---------- Footer ---------- */

.app-footer {
  margin-top: 40px;
  padding: 20px 0 0 0;
  border-top: 1px solid var(--border);
}

.app-footer-inner {
  max-width: 1280px;
  margin: 0 auto;
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 16px;
  font-size: 12.5px;
  color: #64748b;
}

.app-footer-copy { font-weight: 600; }

.app-footer-links {
  display: flex;
  gap: 18px;
}

.app-footer-links a {
  color: #64748b;
  transition: color 0.15s ease;
}

.app-footer-links a:hover {
  color: #2563eb;
}

.app-footer-status {
  display: flex;
  align-items: center;
  gap: 8px;
  font-weight: 600;
}

.app-footer-version {
  padding: 3px 8px;
  background: #f1f5f9;
  border-radius: 5px;
  font-family: monospace;
  font-size: 11px;
}

.app-footer-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #22c55e;
  box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.5);
  animation: pulse-dot 2s ease-out infinite;
}

.app-footer-label {
  font-size: 12px;
}

/* ---------- Mobile Topbar (hidden on desktop) ---------- */

.mobile-topbar {
  display: none;
}

.mobile-bottom-nav {
  display: none;
}

/* ---------- Responsive: Mobile ---------- */

@media (max-width: 900px) {
  .app-shell {
    grid-template-columns: 1fr;
  }

  .sidebar {
    display: none;
  }

  .mobile-topbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 14px 20px;
    background: #0f172a;
    color: #ffffff;
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid #1f2937;
  }

  .mobile-topbar .sidebar-brand {
    padding: 0;
    border: none;
    margin: 0;
  }

  .mobile-topbar .sidebar-brand strong {
    color: #ffffff;
  }

  .mobile-topbar .sidebar-brand span {
    color: #64748b;
  }

  .mobile-profile-button {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: linear-gradient(135deg, #2563eb, #7c3aed);
    color: #ffffff;
    border: none;
    font-weight: 800;
    font-size: 13px;
    cursor: pointer;
  }

  .app-content {
    padding: 20px 16px 100px 16px;
  }

  .mobile-bottom-nav {
    display: flex;
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    background: #0f172a;
    border-top: 1px solid #1f2937;
    padding: 8px 4px;
    justify-content: space-around;
    z-index: 50;
  }

  .mobile-nav-link {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    padding: 6px 10px;
    color: #64748b;
    font-size: 11px;
    font-weight: 600;
    border-radius: 8px;
    transition: color 0.15s ease;
    flex: 1;
    text-align: center;
  }

  .mobile-nav-link span {
    font-size: 16px;
    line-height: 1;
  }

  .mobile-nav-link small {
    font-size: 10px;
  }

  .mobile-nav-link.active {
    color: #60a5fa;
  }
}

/* ============================================================
   BASE UI COMPONENTS
   (used across protected pages)
   ============================================================ */

/* Page container */
.page-container,
.wallet-page,
.transactions-page,
.market-detail-page,
.deposit-page,
.settings-page,
.ai-page,
.markets-page,
.dashboard-page,
.trades-page,
.leaderboard-page,
.analytics-page,
.watchlist-page,
.trade-details-page,
.profile-page {
  max-width: 1280px;
  margin: 0 auto;
  padding-bottom: 40px;
}

/* Page header pattern */
.page-header {
  margin-bottom: 24px;
}

.page-header h1 {
  font-size: 28px;
  font-weight: 800;
  letter-spacing: -0.02em;
  color: #0f172a;
  margin-bottom: 6px;
}

.page-header p {
  color: #64748b;
  font-size: 14px;
}

/* Standard buttons */
.primary-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 10px 18px;
  background: #0f172a;
  color: #ffffff;
  border: none;
  border-radius: 8px;
  font-size: 13.5px;
  font-weight: 700;
  cursor: pointer;
  transition: all 0.15s ease;
}

.primary-button:hover:not(:disabled) {
  background: #1e293b;
}

.primary-button:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.secondary-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 10px 18px;
  background: #ffffff;
  color: #0f172a;
  border: 1px solid #e5e7eb;
  border-radius: 8px;
  font-size: 13.5px;
  font-weight: 700;
  cursor: pointer;
  transition: all 0.15s ease;
}

.secondary-button:hover:not(:disabled) {
  border-color: #cbd5e1;
  background: #f8fafc;
}

/* Standard card */
.card {
  background: #ffffff;
  border: 1px solid #e5e7eb;
  border-radius: 14px;
  padding: 22px;
  box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);
}

/* Standard input */
input[type="text"],
input[type="email"],
input[type="password"],
input[type="number"],
select,
textarea {
  width: 100%;
  padding: 10px 14px;
  border: 1px solid #e5e7eb;
  border-radius: 8px;
  font-size: 14px;
  color: #0f172a;
  background: #ffffff;
  outline: none;
  transition: border-color 0.15s ease, box-shadow 0.15s ease;
}

input:focus,
select:focus,
textarea:focus {
  border-color: #2563eb;
  box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
}

/* Standard table */
table {
  width: 100%;
  border-collapse: collapse;
  background: #ffffff;
  border-radius: 12px;
  overflow: hidden;
}

th {
  text-align: left;
  padding: 12px 16px;
  background: #f8fafc;
  font-size: 11.5px;
  font-weight: 800;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  color: #64748b;
  border-bottom: 1px solid #e5e7eb;
}

td {
  padding: 14px 16px;
  font-size: 13.5px;
  color: #0f172a;
  border-bottom: 1px solid #f1f5f9;
}

tr:last-child td {
  border-bottom: none;
}

/* Utility classes */
.rise-text { color: #16a34a; font-weight: 700; }
.fall-text { color: #dc2626; font-weight: 700; }

.status-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #22c55e;
  display: inline-block;
  box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.5);
  animation: pulse-dot 2s ease-out infinite;
}

@keyframes pulse-dot {
  0%, 100% { box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.5); }
  50% { box-shadow: 0 0 0 6px rgba(34, 197, 94, 0); }
}
/* ============================================================
   YOUNGTRADERS — BASE STYLES (The missing foundation)
   ============================================================ */

:root {
  --brand: #2563eb;
  --bg-dark: #0f172a;
  --bg-light: #ffffff;
  --text-dark: #0f172a;
  --text-light: #64748b;
  --border: #e5e7eb;
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  font-family: 'Inter', system-ui, -apple-system, sans-serif;
  background-color: var(--bg-light);
  color: var(--text-dark);
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}

#root {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
}

/* Navigation */
nav {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16px 32px;
  background-color: #ffffff;
  border-bottom: 1px solid var(--border);
  position: sticky;
  top: 0;
  z-index: 100;
}

nav h1 {
  font-size: 1.25rem;
  font-weight: 800;
  color: var(--text-dark);
  letter-spacing: -0.02em;
}

nav a {
  color: var(--text-light);
  text-decoration: none;
  margin-left: 20px;
  font-size: 0.9rem;
  font-weight: 600;
  padding: 6px 0;
}

nav a:hover {
  color: var(--brand);
}

/* Hero Section */
.hero-section {
  padding: 80px 32px;
  text-align: center;
  background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
}

.hero-section h2 {
  font-size: 3rem;
  font-weight: 800;
  letter-spacing: -0.03em;
  margin-bottom: 16px;
  color: var(--text-dark);
}

.hero-section p {
  color: var(--text-light);
  font-size: 1.1rem;
  max-width: 600px;
  margin: 0 auto 32px auto;
}

/* Buttons */
button, .btn {
  background-color: var(--bg-dark);
  color: #ffffff;
  border: none;
  padding: 12px 24px;
  font-size: 0.95rem;
  font-weight: 700;
  border-radius: 8px;
  cursor: pointer;
  transition: all 0.2s ease;
  text-decoration: none;
  display: inline-block;
  margin: 4px;
}

button:hover, .btn:hover {
  background-color: #1e293b;
  transform: translateY(-1px);
}

/* Market Ticker */
.ticker {
  background-color: #f1f5f9;
  border-bottom: 1px solid var(--border);
  padding: 8px 0;
  overflow: hidden;
  white-space: nowrap;
  font-family: monospace;
  font-size: 0.8rem;
  color: var(--text-dark);
}

/* General Layout & Cards */
.main-content {
  max-width: 1200px;
  margin: 0 auto;
  padding: 32px;
  width: 100%;
}

.card, .feature-card {
  background: #ffffff;
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 24px;
  margin-bottom: 20px;
  box-shadow: 0 1px 2px rgba(0,0,0,0.05);
}

h3 {
  font-size: 1.5rem;
  font-weight: 700;
  margin-bottom: 12px;
}

p {
  margin-bottom: 16px;
}

/* ============================================================
   YOUNGTRADERS — ANIMATION SYSTEM
   Phase 2 — Foundation layer
   Safe to append at the end of the stylesheet.
   Uses only CSS. No JS changes required.
   ============================================================ */

:root {
  /* Durations */
  --dur-instant: 80ms;
  --dur-fast: 150ms;
  --dur-base: 240ms;
  --dur-slow: 420ms;
  --dur-page: 520ms;

  /* Easing curves */
  --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
  --ease-in-out: cubic-bezier(0.65, 0, 0.35, 1);
  --ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);

  /* Shadows */
  --shadow-sm: 0 1px 2px rgba(15, 23, 42, 0.04);
  --shadow-md: 0 8px 24px rgba(15, 23, 42, 0.06);
  --shadow-lg: 0 16px 40px rgba(15, 23, 42, 0.1);
  --shadow-xl: 0 24px 60px rgba(15, 23, 42, 0.14);
}

/* ---------- Page enter ---------------------------------- */

@keyframes yt-page-enter {
  from {
    opacity: 0;
    transform: translateY(12px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.page-container,
.wallet-page,
.transactions-page,
.market-detail-page,
.deposit-page,
.settings-page,
.ai-page,
.markets-page,
.dashboard-page {
  animation: yt-page-enter var(--dur-page) var(--ease-out) both;
}

/* ---------- Stagger utilities --------------------------- */

.stagger > * {
  animation: yt-page-enter var(--dur-page) var(--ease-out) both;
}

.stagger > *:nth-child(1) { animation-delay: 0ms; }
.stagger > *:nth-child(2) { animation-delay: 60ms; }
.stagger > *:nth-child(3) { animation-delay: 120ms; }
.stagger > *:nth-child(4) { animation-delay: 180ms; }
.stagger > *:nth-child(5) { animation-delay: 240ms; }
.stagger > *:nth-child(6) { animation-delay: 300ms; }
.stagger > *:nth-child(7) { animation-delay: 360ms; }
.stagger > *:nth-child(8) { animation-delay: 420ms; }

/* ---------- Button micro-interactions ------------------- */

.primary-button,
.secondary-button,
.auth-submit,
.deposit-primary,
.deposit-secondary,
.wallet-deposit-button,
.home-primary-button,
.home-secondary-button,
.home-nav-cta,
.home-cta-button,
.home-pricing-cta,
.markets-trade-button,
.ai-send-button,
.ai-quick-button {
  transition:
    transform var(--dur-fast) var(--ease-out),
    box-shadow var(--dur-fast) var(--ease-out),
    background var(--dur-fast) var(--ease-out),
    opacity var(--dur-fast) var(--ease-out);
}

.primary-button:hover:not(:disabled),
.auth-submit:hover:not(:disabled),
.deposit-primary:hover:not(:disabled),
.wallet-deposit-button:hover:not(:disabled),
.home-primary-button:hover:not(:disabled),
.home-nav-cta:hover:not(:disabled),
.home-cta-button:hover:not(:disabled),
.home-pricing-cta.highlight:hover:not(:disabled),
.markets-trade-button:hover:not(:disabled),
.ai-send-button:hover:not(:disabled) {
  transform: translateY(-2px);
  box-shadow: var(--shadow-md);
}

.secondary-button:hover:not(:disabled),
.deposit-secondary:hover:not(:disabled),
.home-secondary-button:hover,
.home-pricing-cta:not(.highlight):hover:not(:disabled),
.ai-quick-button:hover:not(:disabled) {
  transform: translateY(-1px);
  box-shadow: var(--shadow-sm);
}

.primary-button:active:not(:disabled),
.auth-submit:active:not(:disabled),
.deposit-primary:active:not(:disabled),
.wallet-deposit-button:active:not(:disabled),
.home-primary-button:active:not(:disabled),
.home-nav-cta:active:not(:disabled) {
  transform: translateY(0);
  transition-duration: var(--dur-instant);
}

/* ---------- Card hover elevation ------------------------ */

.dashboard-stat-card,
.trading-panel,
.trade-form-panel,
.wallet-card,
.wallet-balance-card,
.active-trade-card,
.detail-main-card,
.detail-result-card,
.market-overview-card,
.market-chart-panel,
.market-trade-panel,
.settings-section,
.deposit-card,
.ai-chat-shell,
.admin-stat-card,
.admin-section,
.transactions-summary-card,
.transactions-table,
.markets-table {
  transition:
    transform var(--dur-base) var(--ease-out),
    box-shadow var(--dur-base) var(--ease-out),
    border-color var(--dur-base) var(--ease-out);
}

.dashboard-stat-card:hover,
.active-trade-card:hover,
.market-overview-card:hover,
.transactions-summary-card:hover,
.settings-section:hover {
  transform: translateY(-2px);
  box-shadow: var(--shadow-md);
}

.dashboard-stat-card:hover {
  border-color: #cbd5e1;
}

/* ---------- Input focus glow ---------------------------- */

input,
select,
textarea {
  transition:
    border-color var(--dur-fast) var(--ease-out),
    box-shadow var(--dur-fast) var(--ease-out),
    background var(--dur-fast) var(--ease-out);
}

input:focus,
select:focus,
textarea:focus {
  border-color: var(--brand);
  box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
}

/* ---------- Row interactions ---------------------------- */

.markets-table-row,
.full-trades-row,
.recent-trade-row,
.transactions-table-row,
.nav-link,
.home-nav-link,
.home-ticker-item,
.home-feature-card,
.home-pricing-card,
.home-testimonial,
.home-faq-item,
.home-how-step,
.info-value-card,
.info-contact-card,
.settings-field,
.sidebar-logout {
  transition:
    background var(--dur-fast) var(--ease-out),
    color var(--dur-fast) var(--ease-out),
    border-color var(--dur-fast) var(--ease-out),
    transform var(--dur-fast) var(--ease-out),
    box-shadow var(--dur-fast) var(--ease-out);
}

.recent-trade-row:hover,
.transactions-table-row:hover,
.full-trades-row:hover {
  transform: translateX(2px);
}

.markets-table-row:hover {
  transform: translateX(2px);
}

/* ---------- Nav link underline effect ------------------- */

.nav-link,
.home-nav-link {
  position: relative;
  overflow: hidden;
}

.nav-link::after,
.home-nav-link::after {
  content: "";
  position: absolute;
  left: 12px;
  right: 12px;
  bottom: 6px;
  height: 2px;
  border-radius: 2px;
  background: currentColor;
  transform: scaleX(0);
  transform-origin: left center;
  transition: transform var(--dur-base) var(--ease-out);
  opacity: 0.6;
}

.nav-link:hover::after,
.home-nav-link:hover::after {
  transform: scaleX(1);
}

.nav-link.active::after {
  transform: scaleX(1);
}

/* ---------- Watch star spin ----------------------------- */

.watch-star {
  transition:
    transform var(--dur-base) var(--ease-spring),
    color var(--dur-fast) var(--ease-out),
    background var(--dur-fast) var(--ease-out);
}

.watch-star:hover {
  transform: scale(1.15) rotate(-8deg);
}

.watch-star.active {
  animation: yt-star-pop var(--dur-base) var(--ease-spring);
}

@keyframes yt-star-pop {
  0% { transform: scale(1) rotate(0); }
  50% { transform: scale(1.35) rotate(18deg); }
  100% { transform: scale(1) rotate(0); }
}

/* ---------- Price flash pulse --------------------------- */

.markets-price.flash-up {
  animation: yt-price-up 600ms var(--ease-out);
}

.markets-price.flash-down {
  animation: yt-price-down 600ms var(--ease-out);
}

@keyframes yt-price-up {
  0% { background: #dcfce7; transform: scale(1.02); }
  100% { background: transparent; transform: scale(1); }
}

@keyframes yt-price-down {
  0% { background: #fee2e2; transform: scale(1.02); }
  100% { background: transparent; transform: scale(1); }
}

/* ---------- Toast slide-in refresh ---------------------- */

@keyframes yt-toast-in {
  from {
    opacity: 0;
    transform: translateX(24px) scale(0.96);
  }
  to {
    opacity: 1;
    transform: translateX(0) scale(1);
  }
}

.toast {
  animation: yt-toast-in var(--dur-base) var(--ease-out);
}

/* ---------- Skeleton shimmer refresh -------------------- */

@keyframes yt-skeleton {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

.skeleton {
  background: linear-gradient(
    90deg,
    #eef2f7 0%,
    #e2e8f0 50%,
    #eef2f7 100%
  );
  background-size: 200% 100%;
  animation: yt-skeleton 1.6s var(--ease-in-out) infinite;
}

/* ---------- Verdict meter grow -------------------------- */

@keyframes yt-bar-grow {
  from { transform: scaleX(0); }
  to { transform: scaleX(1); }
}

.ai-verdict-bar-fill {
  transform-origin: left center;
  animation: yt-bar-grow 700ms var(--ease-out) both;
}

/* ---------- Countdown bar pulse ------------------------- */

@keyframes yt-countdown-pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.75; }
}

.countdown-bar div {
  animation: yt-countdown-pulse 2s var(--ease-in-out) infinite;
}

/* ---------- Live badge soft glow ------------------------ */

@keyframes yt-live-glow {
  0%, 100% {
    box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.35);
  }
  50% {
    box-shadow: 0 0 0 6px rgba(34, 197, 94, 0);
  }
}

.market-live-badge span,
.dashboard-status .status-dot,
.markets-clock-dot,
.app-footer-dot,
.status-dot {
  animation: yt-live-glow 2s var(--ease-out) infinite;
}

/* ---------- FAQ chevron rotate -------------------------- */

.home-faq-chevron {
  transition: transform var(--dur-base) var(--ease-out);
}

.home-faq-item.open .home-faq-chevron {
  transform: rotate(180deg);
}

/* ---------- Pricing card lift -------------------------- */

.home-pricing-card:hover {
  transform: translateY(-4px);
  box-shadow: var(--shadow-lg);
  border-color: rgba(255, 255, 255, 0.2);
}

.home-pricing-card.highlight:hover {
  transform: translateY(-4px) scale(1.05);
  box-shadow: 0 28px 70px -20px rgba(37, 99, 235, 0.6);
}

/* ---------- Testimonial tilt ---------------------------- */

.home-testimonial:hover {
  transform: translateY(-4px);
  box-shadow: var(--shadow-lg);
}

/* ---------- Brand mark shine ---------------------------- */

@keyframes yt-brand-shine {
  0%, 100% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
}

.brand-mark,
.home-brand-mark,
.auth-brand-mark {
  background: linear-gradient(
    135deg,
    #2563eb 0%,
    #6d28d9 50%,
    #7c3aed 100%
  );
  background-size: 200% 200%;
  animation: yt-brand-shine 8s var(--ease-in-out) infinite;
}

/* ---------- Reduced motion ------------------------------ */

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: 0.001ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.001ms !important;
    scroll-behavior: auto !important;
  }
}

/* ============================================================
   DASHBOARD — PHASE 2 FEATURES
   Session strip · Watchlist · Heatmap · AI Verdict · Presets
   ============================================================ */

.dashboard-session-strip {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12px;
  margin-bottom: 20px;
  padding: 16px 20px;
  background: linear-gradient(135deg, #eff6ff 0%, #f5f3ff 100%);
  border: 1px solid #e0e7ff;
  border-radius: 16px;
}

.dashboard-session-item {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.dashboard-session-item span {
  color: #64748b;
  font-size: 11.5px;
  font-weight: 700;
  letter-spacing: 0.4px;
  text-transform: uppercase;
}

.dashboard-session-item strong {
  color: #0f172a;
  font-size: 18px;
  font-weight: 800;
  letter-spacing: -0.01em;
  font-variant-numeric: tabular-nums;
}

.dashboard-watchlist-strip {
  display: flex;
  align-items: center;
  gap: 14px;
  margin-bottom: 20px;
  padding: 12px 16px;
  background: #ffffff;
  border: 1px solid #e5e7eb;
  border-radius: 14px;
  flex-wrap: wrap;
}

.dashboard-watchlist-label {
  font-size: 12px;
  font-weight: 800;
  color: #f59e0b;
  letter-spacing: 0.4px;
  white-space: nowrap;
}

.dashboard-watchlist-items {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}

.dashboard-watchlist-pill {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 7px 12px;
  border-radius: 999px;
  background: #f8fafc;
  border: 1px solid #e5e7eb;
  font-size: 12.5px;
  cursor: pointer;
  transition: background 0.15s ease, border-color 0.15s ease, transform 0.15s ease;
}

.dashboard-watchlist-pill:hover {
  background: #ffffff;
  border-color: #cbd5e1;
  transform: translateY(-1px);
}

.dashboard-watchlist-pill.active {
  background: #eff6ff;
  border-color: #2563eb;
}

.dashboard-watchlist-pill strong {
  color: #0f172a;
  font-weight: 800;
  font-size: 12.5px;
}

.dashboard-watchlist-pill span {
  font-size: 11.5px;
  font-weight: 700;
}

.dashboard-heatmap {
  margin-top: 20px;
  padding-top: 20px;
  border-top: 1px solid #f1f5f9;
}

.dashboard-heatmap-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 12px;
}

.dashboard-heatmap-header small {
  color: #94a3b8;
  font-size: 11px;
}

.dashboard-heatmap-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 8px;
}

.heatmap-tile {
  display: flex;
  flex-direction: column;
  gap: 4px;
  padding: 10px 12px;
  border-radius: 10px;
  border: 1px solid transparent;
  cursor: pointer;
  text-align: left;
  transition: transform 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease;
}

.heatmap-tile.up {
  background: #f0fdf4;
  border-color: #bbf7d0;
}

.heatmap-tile.down {
  background: #fef2f2;
  border-color: #fecaca;
}

.heatmap-tile:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 16px rgba(15, 23, 42, 0.08);
}

.heatmap-tile.active {
  border-color: #2563eb;
  box-shadow: 0 0 0 2px rgba(37, 99, 235, 0.2);
}

.heatmap-tile-symbol {
  font-size: 12px;
  font-weight: 800;
  color: #0f172a;
}

.heatmap-tile-change {
  font-size: 11.5px;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}

.heatmap-tile.up .heatmap-tile-change {
  color: #15803d;
}

.heatmap-tile.down .heatmap-tile-change {
  color: #b91c1c;
}

.ai-verdict-widget {
  padding: 16px;
  margin-bottom: 18px;
  border-radius: 14px;
  background: #f8fafc;
  border: 1px solid #e5e7eb;
  transition: background 0.2s ease, border-color 0.2s ease;
}

.ai-verdict-widget.strong {
  background: linear-gradient(135deg, #f0fdf4, #ffffff);
  border-color: #bbf7d0;
}

.ai-verdict-widget.moderate {
  background: linear-gradient(135deg, #eff6ff, #ffffff);
  border-color: #bfdbfe;
}

.ai-verdict-widget.weak {
  background: linear-gradient(135deg, #fffbeb, #ffffff);
  border-color: #fde68a;
}

.ai-verdict-widget.low {
  background: linear-gradient(135deg, #fef2f2, #ffffff);
  border-color: #fecaca;
}

.ai-verdict-widget-header {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 12px;
  font-size: 12px;
}

.ai-verdict-widget-icon {
  width: 22px;
  height: 22px;
  border-radius: 6px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: #0f172a;
  color: #ffffff;
  font-size: 11px;
}

.ai-verdict-widget-title {
  font-weight: 800;
  color: #0f172a;
  letter-spacing: 0.3px;
}

.ai-verdict-widget-label {
  margin-left: auto;
  font-size: 11px;
  font-weight: 700;
  color: #64748b;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.ai-verdict-widget-body {
  display: flex;
  align-items: center;
  gap: 14px;
  margin-bottom: 10px;
}

.ai-verdict-widget-number {
  font-size: 28px;
  font-weight: 800;
  letter-spacing: -0.02em;
  color: #0f172a;
  line-height: 1;
  min-width: 68px;
  font-variant-numeric: tabular-nums;
}

.ai-verdict-widget.strong .ai-verdict-widget-number {
  color: #15803d;
}

.ai-verdict-widget.weak .ai-verdict-widget-number {
  color: #b45309;
}

.ai-verdict-widget.low .ai-verdict-widget-number {
  color: #b91c1c;
}

.ai-verdict-widget-bar {
  flex: 1;
  height: 8px;
  border-radius: 999px;
  background: #e2e8f0;
  overflow: hidden;
}

.ai-verdict-widget-bar-fill {
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #2563eb, #7c3aed);
  transition: width 0.8s cubic-bezier(0.16, 1, 0.3, 1);
}

.ai-verdict-widget.strong .ai-verdict-widget-bar-fill {
  background: linear-gradient(90deg, #22c55e, #16a34a);
}

.ai-verdict-widget.low .ai-verdict-widget-bar-fill {
  background: linear-gradient(90deg, #ef4444, #dc2626);
}

.ai-verdict-widget-footer {
  font-size: 12px;
  color: #64748b;
  line-height: 1.5;
}

.ai-verdict-widget-footer strong {
  color: #0f172a;
}

.quick-preset-row {
  display: flex;
  gap: 6px;
  margin-bottom: 10px;
  flex-wrap: wrap;
}

.quick-preset {
  flex: 1;
  min-width: 0;
  padding: 8px 12px;
  border-radius: 8px;
  border: 1px solid #e5e7eb;
  background: #ffffff;
  color: #334155;
  font-size: 12.5px;
  font-weight: 700;
  cursor: pointer;
  transition: background 0.15s ease, border-color 0.15s ease, color 0.15s ease, transform 0.15s ease;
}

.quick-preset:hover {
  border-color: #cbd5e1;
  transform: translateY(-1px);
}

.quick-preset.active {
  background: #eff6ff;
  border-color: #2563eb;
  color: #1d4ed8;
}

@media (max-width: 900px) {
  .dashboard-session-strip {
    grid-template-columns: repeat(2, 1fr);
  }

  .dashboard-heatmap-grid {
    grid-template-columns: repeat(3, 1fr);
  }
}

@media (max-width: 600px) {
  .dashboard-session-strip {
    grid-template-columns: 1fr;
    padding: 14px 16px;
  }

  .dashboard-heatmap-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .ai-verdict-widget-number {
    font-size: 24px;
    min-width: 58px;
  }
}

/* ============================================================
   TRADES PAGE — TOOLBAR · SUMMARY · PAGINATION
   ============================================================ */

.trades-page {
  padding-top: 32px;
}

.trades-summary {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14px;
  margin-bottom: 22px;
}

.trades-summary-card {
  padding: 18px 20px;
  background: #ffffff;
  border: 1px solid #e5e7eb;
  border-radius: 14px;
  display: flex;
  flex-direction: column;
  gap: 4px;
  box-shadow: 0 4px 12px rgba(15, 23, 42, 0.03);
}

.trades-summary-card span {
  color: #64748b;
  font-size: 12.5px;
  font-weight: 700;
  letter-spacing: 0.3px;
  text-transform: uppercase;
}

.trades-summary-card strong {
  font-size: 22px;
  letter-spacing: -0.01em;
  font-variant-numeric: tabular-nums;
}

.trades-summary-card small {
  color: #94a3b8;
  font-size: 11.5px;
}

.trades-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 16px;
  flex-wrap: wrap;
}

.trades-toolbar-right {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-wrap: wrap;
}

.trades-toolbar-right .secondary-button {
  height: 40px;
  padding: 0 16px;
}

.full-trades-header,
.full-trades-row {
  grid-template-columns:
    minmax(120px, 1fr)
    minmax(110px, 1fr)
    minmax(90px, 0.8fr)
    minmax(90px, 0.8fr)
    minmax(100px, 0.9fr)
    minmax(100px, 0.9fr)
    80px;
}

.trades-date {
  color: #64748b;
  font-size: 12.5px;
  white-space: nowrap;
}

.trades-pagination {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14px;
  margin-top: 24px;
  padding: 14px;
  background: #ffffff;
  border: 1px solid #e5e7eb;
  border-radius: 14px;
}

.trades-pagination .secondary-button {
  height: 38px;
  padding: 0 16px;
}

.trades-pagination-label {
  color: #475569;
  font-size: 13px;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}

@media (max-width: 900px) {
  .trades-summary {
    grid-template-columns: repeat(2, 1fr);
  }

  .trades-toolbar {
    flex-direction: column;
    align-items: stretch;
  }

  .trades-toolbar-right {
    flex-direction: column;
    align-items: stretch;
  }

  .trades-toolbar-right .markets-search,
  .trades-toolbar-right .markets-sort {
    width: 100%;
  }
}

@media (max-width: 600px) {
  .trades-summary {
    grid-template-columns: 1fr;
  }

  .full-trades-table {
    overflow-x: auto;
  }

  .full-trades-header,
  .full-trades-row {
    min-width: 780px;
  }

  .trades-pagination {
    flex-direction: column;
    gap: 10px;
  }
}

/* ============================================================
   TRADE DETAILS PAGE — FULL VERSION
   ============================================================ */

.trade-details-page {
  padding-top: 24px;
}

.trade-banner {
  display: flex;
  align-items: center;
  gap: 22px;
  padding: 28px 30px;
  margin-bottom: 20px;
  border-radius: 20px;
  background: #ffffff;
  border: 1px solid #e5e7eb;
  box-shadow: 0 12px 30px rgba(15, 23, 42, 0.05);
  flex-wrap: wrap;
}

.trade-banner-won {
  background: linear-gradient(135deg, #f0fdf4 0%, #ffffff 100%);
  border-color: #bbf7d0;
}

.trade-banner-lost {
  background: linear-gradient(135deg, #fef2f2 0%, #ffffff 100%);
  border-color: #fecaca;
}

.trade-banner-pending {
  background: linear-gradient(135deg, #fffbeb 0%, #ffffff 100%);
  border-color: #fde68a;
}

.trade-banner-cancelled {
  background: linear-gradient(135deg, #f8fafc 0%, #ffffff 100%);
  border-color: #e2e8f0;
}

.trade-banner-icon {
  width: 68px;
  height: 68px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30px;
  font-weight: 800;
  flex-shrink: 0;
  color: #ffffff;
}

.trade-banner-won .trade-banner-icon {
  background: linear-gradient(135deg, #22c55e, #16a34a);
  box-shadow: 0 10px 24px rgba(34, 197, 94, 0.28);
}

.trade-banner-lost .trade-banner-icon {
  background: linear-gradient(135deg, #ef4444, #dc2626);
  box-shadow: 0 10px 24px rgba(239, 68, 68, 0.28);
}

.trade-banner-pending .trade-banner-icon {
  background: linear-gradient(135deg, #f59e0b, #d97706);
  box-shadow: 0 10px 24px rgba(245, 158, 11, 0.28);
}

.trade-banner-cancelled .trade-banner-icon {
  background: linear-gradient(135deg, #64748b, #475569);
  box-shadow: 0 10px 24px rgba(100, 116, 139, 0.28);
}

.trade-banner-body {
  flex: 1;
  min-width: 200px;
}

.trade-banner-eyebrow {
  display: block;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 1.2px;
  color: #94a3b8;
  margin-bottom: 6px;
}

.trade-banner-body h1 {
  font-size: 30px;
  letter-spacing: -0.02em;
  margin: 0 0 6px;
  color: #0f172a;
}

.trade-banner-body p {
  margin: 0 0 10px;
  color: #64748b;
  font-size: 14px;
}

.trade-banner-pl {
  font-size: 26px;
  font-weight: 800;
  letter-spacing: -0.02em;
  font-variant-numeric: tabular-nums;
}

.trade-banner-clock {
  font-family: "SF Mono", Menlo, Consolas, monospace;
  font-size: 26px;
}

.trade-banner-pl small {
  display: block;
  font-size: 11px;
  color: #94a3b8;
  letter-spacing: 0.5px;
  text-transform: uppercase;
  font-weight: 700;
  margin-top: 2px;
}

.trade-banner-actions {
  display: flex;
  gap: 10px;
  margin-left: auto;
}

.trade-chip-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12px;
  margin-bottom: 20px;
}

.trade-chip {
  padding: 16px 18px;
  background: #ffffff;
  border: 1px solid #e5e7eb;
  border-radius: 14px;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.trade-chip span {
  color: #64748b;
  font-size: 11.5px;
  font-weight: 700;
  letter-spacing: 0.3px;
  text-transform: uppercase;
}

.trade-chip strong {
  color: #0f172a;
  font-size: 18px;
  font-weight: 800;
  letter-spacing: -0.01em;
  font-variant-numeric: tabular-nums;
}

.trade-comparison {
  padding: 24px;
  margin-bottom: 20px;
  background: #ffffff;
  border: 1px solid #e5e7eb;
  border-radius: 20px;
  box-shadow: 0 8px 30px rgba(15, 23, 42, 0.04);
}

.trade-comparison-header {
  margin-bottom: 22px;
}

.trade-comparison-header h2 {
  margin: 4px 0 0;
  font-size: 22px;
  letter-spacing: -0.01em;
}

.trade-comparison-body {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  gap: 20px;
  padding: 22px 0;
  border-top: 1px solid #f1f5f9;
  border-bottom: 1px solid #f1f5f9;
}

.trade-comparison-side {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.trade-comparison-side:last-child {
  text-align: right;
  align-items: flex-end;
}

.trade-comparison-side span {
  color: #64748b;
  font-size: 11.5px;
  font-weight: 700;
  letter-spacing: 0.5px;
  text-transform: uppercase;
}

.trade-comparison-side strong {
  color: #0f172a;
  font-size: 26px;
  font-weight: 800;
  letter-spacing: -0.02em;
  font-variant-numeric: tabular-nums;
}

.trade-comparison-side small {
  color: #94a3b8;
  font-size: 11.5px;
}

.trade-comparison-arrow {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
  padding: 0 10px;
  position: relative;
}

.trade-comparison-arrow-line {
  position: absolute;
  top: 24px;
  left: -40px;
  right: -40px;
  height: 2px;
  background: #e2e8f0;
}

.trade-comparison-arrow.up .trade-comparison-arrow-line {
  background: linear-gradient(90deg, #e2e8f0, #22c55e);
}

.trade-comparison-arrow.down .trade-comparison-arrow-line {
  background: linear-gradient(90deg, #e2e8f0, #ef4444);
}

.trade-comparison-arrow-icon {
  width: 42px;
  height: 42px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20px;
  font-weight: 800;
  color: #ffffff;
  background: #64748b;
  position: relative;
  z-index: 1;
}

.trade-comparison-arrow.up .trade-comparison-arrow-icon {
  background: linear-gradient(135deg, #22c55e, #16a34a);
  box-shadow: 0 8px 20px rgba(34, 197, 94, 0.28);
}

.trade-comparison-arrow.down .trade-comparison-arrow-icon {
  background: linear-gradient(135deg, #ef4444, #dc2626);
  box-shadow: 0 8px 20px rgba(239, 68, 68, 0.28);
}

.trade-comparison-arrow small {
  font-size: 12px;
  font-weight: 700;
  color: #64748b;
  font-variant-numeric: tabular-nums;
  margin-top: 4px;
}

.trade-comparison-arrow.up small {
  color: #15803d;
}

.trade-comparison-arrow.down small {
  color: #b91c1c;
}

.trade-comparison-summary {
  padding-top: 18px;
}

.trade-comparison-summary p {
  margin: 0;
  color: #475569;
  font-size: 14px;
  line-height: 1.7;
}

.trade-comparison-summary strong {
  color: #0f172a;
}

.trade-timeline {
  padding: 24px;
  margin-bottom: 20px;
  background: #ffffff;
  border: 1px solid #e5e7eb;
  border-radius: 20px;
  box-shadow: 0 8px 30px rgba(15, 23, 42, 0.04);
}

.trade-timeline-items {
  display: flex;
  align-items: flex-start;
  margin-top: 16px;
  flex-wrap: wrap;
  gap: 0;
}

.trade-timeline-item {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  flex: 1;
  min-width: 160px;
}

.trade-timeline-dot {
  width: 14px;
  height: 14px;
  border-radius: 50%;
  background: #cbd5e1;
  flex-shrink: 0;
  margin-top: 4px;
  position: relative;
}

.trade-timeline-dot.done {
  background: #2563eb;
  box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.15);
}

.trade-timeline-dot.pending {
  background: #f59e0b;
  box-shadow: 0 0 0 4px rgba(245, 158, 11, 0.18);
  animation: pulse-dot 1.6s ease-in-out infinite;
}

.trade-timeline-item strong {
  display: block;
  font-size: 13px;
  color: #0f172a;
  margin-bottom: 2px;
}

.trade-timeline-item small {
  display: block;
  font-size: 12px;
  color: #64748b;
}

.trade-timeline-connector {
  flex: 0 0 40px;
  height: 2px;
  background: #e2e8f0;
  margin-top: 10px;
  min-width: 24px;
}

.trade-details-disclaimer {
  padding: 16px 20px;
  border-radius: 14px;
  background: #f8fafc;
  border: 1px solid #e5e7eb;
  color: #64748b;
  font-size: 12.5px;
  line-height: 1.6;
  text-align: center;
}

@media (max-width: 900px) {
  .trade-chip-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .trade-comparison-body {
    grid-template-columns: 1fr;
    gap: 24px;
  }

  .trade-comparison-side,
  .trade-comparison-side:last-child {
    text-align: center;
    align-items: center;
  }

  .trade-comparison-arrow {
    transform: rotate(90deg);
    margin: 10px 0;
  }

  .trade-timeline-items {
    flex-direction: column;
    gap: 20px;
  }

  .trade-timeline-connector {
    display: none;
  }

  .trade-banner-actions {
    margin-left: 0;
    width: 100%;
  }

  .trade-banner-actions button {
    flex: 1;
  }
}

@media (max-width: 600px) {
  .trade-banner {
    padding: 22px 20px;
  }

  .trade-banner-icon {
    width: 56px;
    height: 56px;
    font-size: 24px;
  }

  .trade-banner-body h1 {
    font-size: 24px;
  }

  .trade-banner-pl {
    font-size: 22px;
  }

  .trade-chip-grid {
    grid-template-columns: 1fr;
  }

  .trade-comparison-side strong {
    font-size: 22px;
  }
}

/* ============================================================
   MARKET DETAIL — TIMEFRAME · MA · ORDER BOOK
   ============================================================ */

.timeframe-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 16px;
  flex-wrap: wrap;
}

.timeframe-tabs {
  display: inline-flex;
  gap: 4px;
  padding: 4px;
  background: #f8fafc;
  border: 1px solid #e5e7eb;
  border-radius: 10px;
}

.timeframe-tab {
  padding: 6px 12px;
  border: none;
  border-radius: 6px;
  background: transparent;
  color: #64748b;
  font-size: 12.5px;
  font-weight: 700;
  cursor: pointer;
  transition: background 0.15s ease, color 0.15s ease;
}

.timeframe-tab:hover {
  color: #0f172a;
}

.timeframe-tab.active {
  background: #ffffff;
  color: #0f172a;
  box-shadow: 0 1px 3px rgba(15, 23, 42, 0.08);
}

.ma-toggle {
  padding: 7px 14px;
  border-radius: 10px;
  border: 1px solid #e5e7eb;
  background: #ffffff;
  color: #64748b;
  font-size: 12.5px;
  font-weight: 700;
  cursor: pointer;
  transition: background 0.15s ease, border-color 0.15s ease, color 0.15s ease;
}

.ma-toggle:hover {
  border-color: #cbd5e1;
  color: #0f172a;
}

.ma-toggle.active {
  background: #fffbeb;
  border-color: #fbbf24;
  color: #b45309;
}

.order-book-panel {
  margin-top: 24px;
  padding: 24px;
  background: #ffffff;
  border: 1px solid #e5e7eb;
  border-radius: 20px;
  box-shadow: 0 8px 30px rgba(15, 23, 42, 0.04);
}

.order-book-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 18px;
}

.order-book-header h2 {
  margin: 4px 0 0;
  font-size: 20px;
  letter-spacing: -0.01em;
}

.order-book-spread {
  text-align: right;
}

.order-book-spread span {
  display: block;
  color: #64748b;
  font-size: 11.5px;
  font-weight: 700;
  letter-spacing: 0.5px;
  text-transform: uppercase;
  margin-bottom: 4px;
}

.order-book-spread strong {
  color: #0f172a;
  font-size: 15px;
  font-weight: 800;
  font-variant-numeric: tabular-nums;
}

.order-book-columns {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
}

.order-book-side-header {
  display: flex;
  justify-content: space-between;
  padding: 6px 12px;
  margin-bottom: 6px;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.6px;
  text-transform: uppercase;
  color: #94a3b8;
}

.order-book-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8px 12px;
  border-radius: 8px;
  position: relative;
  font-size: 13px;
  font-variant-numeric: tabular-nums;
  overflow: hidden;
  transition: background 0.15s ease;
}

.order-book-row:hover {
  background: #f8fafc;
}

.order-book-depth {
  position: absolute;
  top: 0;
  bottom: 0;
  right: 0;
  opacity: 0.12;
  pointer-events: none;
}

.order-book-side.bids .order-book-depth {
  background: #22c55e;
}

.order-book-side.asks .order-book-depth {
  background: #ef4444;
}

.order-book-price,
.order-book-size {
  position: relative;
  z-index: 1;
}

.order-book-price {
  font-weight: 800;
}

.order-book-side.bids .order-book-price {
  color: #15803d;
}

.order-book-side.asks .order-book-price {
  color: #b91c1c;
}

.order-book-size {
  color: #64748b;
  font-weight: 600;
}

@media (max-width: 700px) {
  .order-book-columns {
    grid-template-columns: 1fr;
    gap: 16px;
  }

  .order-book-header {
    flex-direction: column;
    align-items: flex-start;
  }

  .order-book-spread {
    text-align: left;
  }

  .timeframe-row {
    flex-direction: column;
    align-items: stretch;
  }

  .timeframe-tabs {
    justify-content: space-between;
  }

  .timeframe-tab {
    flex: 1;
  }

  .ma-toggle {
    width: 100%;
    text-align: center;
  }
}

/* ============================================================
   LEADERBOARD PAGE
   ============================================================ */

.leaderboard-page {
  padding-top: 32px;
}

.leaderboard-range {
  display: inline-flex;
  gap: 4px;
  padding: 4px;
  background: #f8fafc;
  border: 1px solid #e5e7eb;
  border-radius: 12px;
}

.leaderboard-range-btn {
  padding: 8px 14px;
  border: none;
  border-radius: 8px;
  background: transparent;
  color: #64748b;
  font-size: 12.5px;
  font-weight: 700;
  cursor: pointer;
  transition: background 0.15s ease, color 0.15s ease;
}

.leaderboard-range-btn:hover {
  color: #0f172a;
}

.leaderboard-range-btn.active {
  background: var(--bg-dark);
  color: #ffffff;
}

.leaderboard-podium {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14px;
  margin-bottom: 24px;
  align-items: end;
}

.podium-card {
  padding: 22px 18px;
  background: #ffffff;
  border: 1px solid #e5e7eb;
  border-radius: 18px;
  text-align: center;
  box-shadow: 0 8px 24px rgba(15, 23, 42, 0.04);
}

.podium-1 {
  transform: translateY(-14px);
  border-color: #fbbf24;
  background: linear-gradient(180deg, #fffbeb, #ffffff);
  box-shadow: 0 16px 40px rgba(251, 191, 36, 0.2);
}

.podium-2 {
  border-color: #cbd5e1;
  background: linear-gradient(180deg, #f8fafc, #ffffff);
}

.podium-3 {
  border-color: #fdba74;
  background: linear-gradient(180deg, #fff7ed, #ffffff);
}

.podium-rank {
  font-size: 30px;
  margin-bottom: 8px;
}

.podium-avatar {
  width: 54px;
  height: 54px;
  border-radius: 50%;
  margin: 0 auto 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #2563eb, #7c3aed);
  color: #ffffff;
  font-size: 22px;
  font-weight: 800;
}

.podium-name strong {
  display: block;
  font-size: 15px;
  color: #0f172a;
}

.podium-name span {
  display: block;
  font-size: 18px;
  margin-top: 2px;
}

.podium-net {
  display: block;
  margin: 12px 0;
  font-size: 20px;
  font-weight: 800;
  letter-spacing: -0.01em;
  font-variant-numeric: tabular-nums;
}

.podium-stats {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8px;
  padding-top: 12px;
  border-top: 1px solid #f1f5f9;
}

.podium-stats span {
  display: block;
  font-size: 10.5px;
  font-weight: 700;
  color: #94a3b8;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  margin-bottom: 2px;
}

.podium-stats strong {
  display: block;
  font-size: 14px;
  color: #0f172a;
}

.leaderboard-table {
  background: #ffffff;
  border: 1px solid #e5e7eb;
  border-radius: 16px;
  overflow: hidden;
  margin-bottom: 20px;
}

.leaderboard-table-head,
.leaderboard-table-row {
  display: grid;
  grid-template-columns: 60px 1.6fr 1fr 1fr 1fr;
  gap: 14px;
  align-items: center;
  padding: 14px 22px;
}

.leaderboard-table-head {
  background: #f8fafc;
  border-bottom: 1px solid #e5e7eb;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.6px;
  color: #64748b;
  text-transform: uppercase;
}

.leaderboard-table-row {
  border-bottom: 1px solid #f1f5f9;
  font-size: 13.5px;
  transition: background 0.12s ease;
}

.leaderboard-table-row:last-child {
  border-bottom: none;
}

.leaderboard-table-row:hover {
  background: #f8fafc;
}

.leaderboard-rank {
  font-size: 15px;
  font-weight: 800;
  color: #94a3b8;
  font-variant-numeric: tabular-nums;
}

.leaderboard-user {
  display: flex;
  align-items: center;
  gap: 10px;
}

.leaderboard-avatar {
  width: 34px;
  height: 34px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #2563eb, #7c3aed);
  color: #ffffff;
  font-weight: 800;
  font-size: 13px;
  flex-shrink: 0;
}

.leaderboard-user strong {
  display: block;
  color: #0f172a;
  font-size: 13.5px;
}

.leaderboard-user span {
  display: block;
  font-size: 14px;
  margin-top: 2px;
}

.leaderboard-net {
  text-align: right;
  font-variant-numeric: tabular-nums;
  justify-self: end;
  font-weight: 800;
}

/* ============================================================
   ANALYTICS PAGE
   ============================================================ */

.analytics-page {
  padding-top: 32px;
}

.analytics-summary {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14px;
  margin-bottom: 22px;
}

.analytics-summary-card {
  padding: 20px;
  background: #ffffff;
  border: 1px solid #e5e7eb;
  border-radius: 16px;
  box-shadow: 0 4px 12px rgba(15, 23, 42, 0.03);
}

.analytics-summary-card span {
  display: block;
  color: #64748b;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.4px;
  text-transform: uppercase;
  margin-bottom: 6px;
}

.analytics-summary-card strong {
  display: block;
  font-size: 24px;
  letter-spacing: -0.01em;
  font-variant-numeric: tabular-nums;
}

.analytics-summary-card small {
  display: block;
  margin-top: 6px;
  font-size: 11.5px;
  color: #94a3b8;
}

.analytics-panel {
  padding: 24px;
  margin-bottom: 20px;
  background: #ffffff;
  border: 1px solid #e5e7eb;
  border-radius: 20px;
  box-shadow: 0 8px 30px rgba(15, 23, 42, 0.04);
}

.analytics-panel-header {
  margin-bottom: 20px;
}

.analytics-panel-header h2 {
  margin: 4px 0 0;
  font-size: 20px;
  letter-spacing: -0.01em;
}

.analytics-bars {
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.analytics-bar-row {
  display: grid;
  grid-template-columns: 140px 1fr 110px;
  gap: 14px;
  align-items: center;
}

.analytics-bar-label strong {
  display: block;
  font-size: 13px;
  color: #0f172a;
}

.analytics-bar-label small {
  display: block;
  font-size: 11px;
  color: #94a3b8;
  margin-top: 2px;
}

.analytics-bar-track {
  height: 10px;
  background: #f1f5f9;
  border-radius: 999px;
  overflow: hidden;
}

.analytics-bar-fill {
  height: 100%;
  border-radius: inherit;
  animation: bar-grow 700ms cubic-bezier(0.16, 1, 0.3, 1) both;
  transform-origin: left center;
}

.analytics-bar-fill.rise {
  background: linear-gradient(90deg, #22c55e, #16a34a);
}

.analytics-bar-fill.fall {
  background: linear-gradient(90deg, #ef4444, #dc2626);
}

@keyframes bar-grow {
  from { transform: scaleX(0); }
  to { transform: scaleX(1); }
}

.analytics-bar-value {
  text-align: right;
  font-size: 13px;
  font-weight: 800;
  font-variant-numeric: tabular-nums;
}

.analytics-streak {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}

.streak-dot {
  width: 22px;
  height: 22px;
  border-radius: 6px;
  animation: pop-in 0.3s ease-out both;
}

.streak-dot.win {
  background: linear-gradient(135deg, #22c55e, #16a34a);
}

.streak-dot.loss {
  background: linear-gradient(135deg, #ef4444, #dc2626);
}

.analytics-streak-footer {
  display: flex;
  gap: 22px;
  margin-top: 14px;
  font-size: 13px;
  color: #64748b;
}

.analytics-streak-footer strong {
  color: #0f172a;
}

.analytics-direction-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14px;
}

.analytics-direction-card {
  padding: 20px;
  border-radius: 14px;
  border: 1px solid #e5e7eb;
}

.analytics-direction-card.rise {
  background: linear-gradient(135deg, #f0fdf4, #ffffff);
  border-color: #bbf7d0;
}

.analytics-direction-card.fall {
  background: linear-gradient(135deg, #fef2f2, #ffffff);
  border-color: #fecaca;
}

.analytics-direction-card span {
  display: block;
  font-size: 12px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  color: #64748b;
  margin-bottom: 8px;
}

.analytics-direction-card strong {
  display: block;
  font-size: 22px;
  letter-spacing: -0.01em;
  font-variant-numeric: tabular-nums;
}

.analytics-direction-card small {
  display: block;
  margin-top: 4px;
  font-size: 11.5px;
  color: #94a3b8;
}

.analytics-highlights {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14px;
}

.analytics-highlight-card {
  text-align: left;
  padding: 22px;
  border-radius: 18px;
  border: 1px solid #e5e7eb;
  background: #ffffff;
  cursor: pointer;
  transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
}

.analytics-highlight-card:hover {
  transform: translateY(-2px);
  box-shadow: 0 12px 30px rgba(15, 23, 42, 0.08);
}

.analytics-highlight-card.best {
  border-color: #bbf7d0;
  background: linear-gradient(135deg, #f0fdf4, #ffffff);
}

.analytics-highlight-card.worst {
  border-color: #fecaca;
  background: linear-gradient(135deg, #fef2f2, #ffffff);
}

.analytics-highlight-card strong {
  display: block;
  font-size: 24px;
  margin: 6px 0 4px;
  letter-spacing: -0.02em;
  font-variant-numeric: tabular-nums;
}

.analytics-highlight-card small {
  display: block;
  color: #64748b;
  font-size: 13px;
}

/* ============================================================
   WATCHLIST PAGE
   ============================================================ */

.watchlist-page {
  padding-top: 32px;
}

.watchlist-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  gap: 16px;
}

.watchlist-card {
  padding: 20px;
  background: #ffffff;
  border: 1px solid #e5e7eb;
  border-radius: 18px;
  box-shadow: 0 4px 12px rgba(15, 23, 42, 0.03);
  display: flex;
  flex-direction: column;
  gap: 12px;
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}

.watchlist-card:hover {
  transform: translateY(-2px);
  box-shadow: 0 12px 30px rgba(15, 23, 42, 0.08);
}

.watchlist-card-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 10px;
}

.watchlist-symbol {
  display: block;
  font-size: 15px;
  font-weight: 800;
  color: #0f172a;
}

.watchlist-name {
  display: block;
  margin-top: 2px;
  font-size: 12px;
  color: #64748b;
}

.watchlist-remove {
  width: 26px;
  height: 26px;
  border-radius: 50%;
  border: none;
  background: #f1f5f9;
  color: #64748b;
  font-size: 16px;
  line-height: 1;
  cursor: pointer;
  transition: background 0.15s ease, color 0.15s ease;
}

.watchlist-remove:hover {
  background: #fee2e2;
  color: #b91c1c;
}

.watchlist-price-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 8px;
}

.watchlist-price {
  font-size: 22px;
  font-weight: 800;
  letter-spacing: -0.02em;
  color: #0f172a;
  font-variant-numeric: tabular-nums;
}

.watchlist-spark {
  display: flex;
  align-items: center;
  height: 32px;
}

.watchlist-spark svg {
  display: block;
  width: 100%;
  height: 30px;
}

.watchlist-trade-button {
  padding: 10px;
  border-radius: 10px;
  border: none;
  background: var(--bg-dark);
  color: #ffffff;
  font-size: 13px;
  font-weight: 700;
  cursor: pointer;
  transition: background 0.15s ease;
}

.watchlist-trade-button:hover {
  background: #1e293b;
}

/* ============================================================
   RESPONSIVE — INSIGHTS PAGES
   ============================================================ */

@media (max-width: 900px) {
  .leaderboard-podium {
    grid-template-columns: 1fr;
    gap: 10px;
  }

  .podium-1 {
    transform: none;
  }

  .analytics-summary {
    grid-template-columns: repeat(2, 1fr);
  }

  .analytics-bar-row {
    grid-template-columns: 100px 1fr 90px;
    gap: 10px;
  }

  .analytics-direction-grid,
  .analytics-highlights {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 650px) {
  .leaderboard-table-head,
  .leaderboard-table-row {
    grid-template-columns: 50px 1.5fr 1fr;
    gap: 10px;
    padding: 12px 16px;
  }

  .leaderboard-table-head span:nth-child(3),
  .leaderboard-table-row span:nth-child(3),
  .leaderboard-table-head span:nth-child(4),
  .leaderboard-table-row span:nth-child(4) {
    display: none;
  }

  .analytics-summary {
    grid-template-columns: 1fr;
  }

  .analytics-bar-row {
    grid-template-columns: 1fr;
    gap: 6px;
  }

  .analytics-bar-value {
    text-align: left;
  }
}